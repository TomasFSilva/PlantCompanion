<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="PlantCompanion.MainPage"
             BackgroundImageSource="background.jpg">

    <Grid Padding="20">
        <!-- Estrutura principal com cabeçalho, imagem e controles -->
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Cabeçalho com título e descrição -->
        <StackLayout Grid.Row="0" VerticalOptions="Start" Padding="0,20,0,10">
            <Label Text="Plant Identifier"
                   FontSize="24"
                   FontAttributes="Bold"
                   TextColor="#FFFFFF"
                   HorizontalOptions="Center">
                <Label.Shadow>
                    <Shadow Brush="Black" Opacity="0.8" Offset="2,2" Radius="5"/>
                </Label.Shadow>
            </Label>
            <Label Text="Tire uma foto ou envie uma imagem para identificar a planta"
                   FontSize="14"
                   TextColor="#FFFFFF"
                   FontAttributes="Bold"
                   HorizontalOptions="Center">
                <Label.Shadow>
                    <Shadow Brush="Black" Opacity="0.8" Offset="2,2" Radius="5"/>
                </Label.Shadow>
            </Label>
        </StackLayout>

        <!-- Área da imagem -->
        <StackLayout Grid.Row="1" VerticalOptions="CenterAndExpand" Spacing="15">
            <Frame CornerRadius="15" Padding="10" BackgroundColor="White" HasShadow="True">
                <CarouselView x:Name="ImageCarousel" HeightRequest="250" HorizontalOptions="Center" VerticalOptions="Center">
                    <CarouselView.ItemTemplate>
                        <DataTemplate>
                            <Image Source="{Binding}" Aspect="AspectFit" />
                        </DataTemplate>
                    </CarouselView.ItemTemplate>
                </CarouselView>
            </Frame>
            <Label x:Name="ResultLabel" 
                   Text="Resultado aparecerá aqui" 
                   FontSize="16" 
                   TextColor="#FFFFFF" 
                   HorizontalOptions="Center">
                <Label.Shadow>
                    <Shadow Brush="Black" Opacity="0.8" Offset="2,2" Radius="5"/>
                </Label.Shadow>
            </Label>
            <Label x:Name="HealthStatusLabel" 
                   Text="Saúde da Planta aparecerá aqui" 
                   FontSize="16" 
                   TextColor="#FFFFFF" 
                   HorizontalOptions="Center">
                <Label.Shadow>
                    <Shadow Brush="Black" Opacity="0.8" Offset="2,2" Radius="5"/>
                </Label.Shadow>
            </Label>
        </StackLayout>

        <!-- Controles inferiores -->
        <Frame Grid.Row="2" Padding="10" BackgroundColor="#FFFFFF" CornerRadius="30" HasShadow="True">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Botão esquerdo -->
                <Button Grid.Column="0" 
                        ImageSource="history_icon.svg" 
                        FontSize="20" 
                        BackgroundColor="#2E7D32" 
                        TextColor="White" 
                        WidthRequest="50" 
                        HeightRequest="50" 
                        CornerRadius="25"
                        HorizontalOptions="Center"
                        VerticalOptions="Center"
                        Clicked="OnHistoricoButtonClicked" />

                <!-- Botão principal circular "+" -->
                <Button Grid.Column="1" 
                        ImageSource="scanner_icon_black.svg"
                        FontSize="32" 
                        BackgroundColor="#4CAF50" 
                        TextColor="White" 
                        WidthRequest="70" 
                        HeightRequest="70" 
                        CornerRadius="35"
                        HorizontalOptions="Center"
                        VerticalOptions="Center" 
                        Clicked="OnTakePhotoButtonClicked">
                    <Button.Shadow>
                        <Shadow Brush="#000000" Opacity="0.3" Offset="2,2" Radius="5"/>
                    </Button.Shadow>
                </Button>

                <!-- Botão direito -->
                <Button Grid.Column="2" 
                        x:Name="UploadButton"
                        ImageSource="upload_icon.svg"
                        FontSize="20" 
                        BackgroundColor="#2E7D32" 
                        TextColor="White" 
                        WidthRequest="50" 
                        HeightRequest="50" 
                        CornerRadius="25"
                        HorizontalOptions="Center"
                        VerticalOptions="Center" 
                        Clicked="OnUploadButtonClicked"/>
            </Grid>
        </Frame>
    </Grid>
</ContentPage>